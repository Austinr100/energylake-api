# Copy to .env for local dev (and set these in Railway's Variables tab).
# Do NOT commit the real .env — it's gitignored.

# Same connection string the pantry uses. If it starts with postgres://
# the app rewrites it to postgresql:// automatically (asyncpg requirement).
NEON_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Comma-separated frontend origins allowed to call this API (CORS).
# Add your Vercel domains + localhost for dev.
ALLOWED_ORIGINS="https://energylake.io,https://www.energylake.io,http://localhost:3000"

# ---------------------------------------------------------------------------
# Model Room R2 archive proxy (D-07-22) — the /api/model-room/* endpoints.
# A READ-ONLY R2 token scoped to the d2/ prefix on the archive bucket
# (captain-provisioned, account-token doctrine). Leave unset to disable the
# Model Room routes (they answer 503); the rest of the API is unaffected.
# R2_ENDPOINT defaults to https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# when R2_ACCOUNT_ID is set — override only for a custom/jurisdictional endpoint.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ARCHIVE_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
